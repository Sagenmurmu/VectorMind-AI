# Backend Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Authentication
JWT_SECRET="your-256-bit-secret-key-change-in-production"
JWT_EXPIRES_IN="7d"

# AI Model Keys (Google AI Studio)
GEMINI_API_KEY="your-gemini-api-key"
GOOGLE_GENERATIVE_AI_API_KEY="your-gemini-api-key"

# Database Configuration (Neon PostgreSQL)
# Pooled connection string (for app queries)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.c-4.region.aws.neon.tech/neondb?sslmode=require"
# Direct connection string (for migrations and schema pushes)
DIRECT_URL="postgresql://user:password@ep-sample.c-4.region.aws.neon.tech/neondb?sslmode=require"
